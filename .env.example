PORT=8080
HOST=127.0.0.1
CONTRACTGUARD_DATA_DIR=./data/analyses
CONTRACTGUARD_MAX_SPEC_BYTES=5242880
# Comma-separated development origins. Same-origin production requests need no CORS header.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional V1.1 rule policy. Leave empty to use ContractGuard defaults.
CONTRACTGUARD_POLICY_CONFIG=

# Preferred V1.1 multi-LLM configuration. Copy the example JSON to a local file,
# then set this path. Leave it empty to use the legacy DeepSeek variables below.
CONTRACTGUARD_LLM_CONFIG=

# Provider secrets remain in the server environment. The JSON file contains only
# the corresponding secretEnv names; never place a real API key in JSON or Git.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Legacy DeepSeek-only fallback. These settings are used only when
# CONTRACTGUARD_LLM_CONFIG is empty.
CONTRACTGUARD_AI_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
CONTRACTGUARD_AI_TIMEOUT_MS=30000
# Maximum deterministic findings included in one AI request.
CONTRACTGUARD_AI_MAX_CHANGES=50
# Maximum tokens allowed for the generated JSON review. Keep high enough to avoid truncation.
CONTRACTGUARD_AI_MAX_OUTPUT_TOKENS=8192
# Maximum number of response bytes read from an LLM endpoint.
CONTRACTGUARD_AI_MAX_RESPONSE_BYTES=131072
